{
  "enabled": true,
  "name": "Doraemon: Kiro finished",
  "description": "Tells the Doraemon mascot that Kiro has finished, so the bubble shows a result you can click to jump back to the IDE.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "mkdir -p .kiro/doraemon && printf '%s' '{\"state\":\"done\",\"message\":\"Kiro finished! Click me to see the result.\"}' > .kiro/doraemon/agent-state.json"
  }
}
